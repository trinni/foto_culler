#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="${FOTO_CULLER_PROJECT_DIR:-/home/duy/src/foto_culler}"
VENV_DIR="${FOTO_CULLER_VENV:-$PROJECT_DIR/.venv}"
PYTHON_BIN="$VENV_DIR/bin/python"
SCRIPT="$PROJECT_DIR/foto_culler.py"

if [[ ! -d "$PROJECT_DIR" ]]; then
    printf 'ERROR: Project directory not found: %s\n' \
        "$PROJECT_DIR" >&2
    exit 1
fi

if [[ ! -x "$PYTHON_BIN" ]]; then
    printf 'ERROR: Python virtual environment not found: %s\n' \
        "$VENV_DIR" >&2
    printf 'Run "make install" from the project directory first.\n' \
        >&2
    exit 1
fi

if [[ ! -f "$SCRIPT" ]]; then
    printf 'ERROR: Python application not found: %s\n' \
        "$SCRIPT" >&2
    exit 1
fi

export VIRTUAL_ENV="$VENV_DIR"
export PATH="$VENV_DIR/bin:$PATH"

exec "$PYTHON_BIN" "$SCRIPT" "$@"
